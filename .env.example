# Réglages de Carnet. Copie ce fichier en « .env » (scripts/initialiser.sh le fait pour toi) puis adapte-le.
# Le fichier .env n'est jamais versionné. Aucun secret ici : la clé de signature vit dans secrets/art-hmac.key.

# --- Utilisateur du conteneur : le propriétaire de ton dossier de pages (renseigné par initialiser.sh)
CARNET_UID=1000
CARNET_GID=1000

# --- Tes pages : un dossier de fichiers .md. Défaut : l'espace de démonstration ./demo
# CARNET_ESPACE_HOTE=/chemin/vers/mes/notes
CARNET_NOM_ESPACE=demo
# Prénom affiché à l'accueil (« Bonjour, Camille »). Sert aussi de mention par défaut : @camille.
CARNET_PRENOM=Camille
# Mentions qui placent une page dans « À relire » (séparées par des espaces). Défaut : @ + le prénom.
# CARNET_MENTIONS=@camille @relecture
# Dossiers de premier niveau à ne jamais lire ni lister (séparés par des espaces).
# CARNET_MASQUES=prive
# Corbeille : jours avant l'effacement automatique d'une page supprimée (0 : jamais).
# CARNET_CORBEILLE_JOURS=30
# Historique git (lecture seule) : auto, non, ou chemin d'un dossier git (voir docs/deploiement.md).
# CARNET_GIT=auto
# CARNET_GIT_PREFIXE=
# Textes des écrans hors ligne et d'erreur : réseau privé à allumer, personne à prévenir.
# CARNET_RESEAU=Tailscale
# CARNET_CONTACT=Camille

# --- Identité : QUI a le droit d'ouvrir Carnet
# Carnet ne gère aucun mot de passe. Un proxy authentifiant (Tailscale Serve, oauth2-proxy, Authelia, Cloudflare Access…)
# pose l'identité dans un en-tête HTTP ; Carnet n'accepte que les comptes listés ici (séparés par des espaces).
# Obligatoire hors du mode d'essai local. Voir docs/deploiement.md.
CARNET_UTILISATEURS_AUTORISES=
CARNET_ENTETE_IDENTITE=Tailscale-User-Login
CARNET_ENTETE_NOM=Tailscale-User-Name
# Essai local SEULEMENT (127.0.0.1) : accepte les requêtes sans identité. Le serveur refuse ce mode dès qu'une origine
# non locale est déclarée ci-dessous. Ne le laisse jamais à 1 derrière un proxy.
CARNET_DEV=1

# --- Adresses : comment le navigateur joint Carnet et le serveur d'artefacts
# Une paire « origine de l'application=origine des artefacts » par espace, séparées par des espaces. Les artefacts DOIVENT
# être servis par une AUTRE origine (autre nom d'hôte ou autre port) que Carnet.
# Local (défaut) :
CARNET_ORIGINES_ARTEFACTS=http://127.0.0.1:3020=http://127.0.0.1:3006 http://localhost:3020=http://127.0.0.1:3006
# Tailscale Serve (exemple) :
# CARNET_ORIGINES_ARTEFACTS=https://carnet.mon-reseau.ts.net=https://carnet.mon-reseau.ts.net:8443
# Origine par défaut du serveur d'artefacts (hôte non reconnu) : la même base que ci-dessus.
CARNET_ART_BASE=http://127.0.0.1:3006

# --- Ports publiés sur 127.0.0.1 de la machine (jamais sur l'interface publique)
CARNET_PORT_HOTE=3020
ART_PORT_HOTE=3006
